diff --git a/ios/VoiceHub/MeetingAudioRecorder.swift b/ios/VoiceHub/MeetingAudioRecorder.swift
index d817da7..59cad15 100644
--- a/ios/VoiceHub/MeetingAudioRecorder.swift
+++ b/ios/VoiceHub/MeetingAudioRecorder.swift
@@ -8,24 +8,71 @@ import AVFoundation
 /// Resamples to the same 16kHz mono format AudioCapture streams live audio
 /// in (same AVAudioConverter pattern), both for a small upload size and one
 /// consistent target format across the app.
+///
+/// Robustheit: Die Aufnahme uebersteht Bildschirmsperre und Hintergrund
+/// (Background-Mode "audio" in project.yml plus aktive .playAndRecord-
+/// Session), erkennt Unterbrechungen (Anruf, Siri, Wecker) und Routen-
+/// wechsel (AirPods weg) und schreibt in Documents/Aufnahmen -- sichtbar in
+/// der Dateien-App, damit ein fehlgeschlagener Upload nie das einzige
+/// Exemplar des Meetings verliert (Datenverlust-Befund vom 23.08.).
 final class MeetingAudioRecorder {
-    private let engine = AVAudioEngine()
+    private var engine = AVAudioEngine()
     private var converter: AVAudioConverter?
     private var audioFile: AVAudioFile?
     private let targetFormat = AVAudioFormat(commonFormat: .pcmFormatInt16, sampleRate: 16000, channels: 1, interleaved: true)!
     private var currentLevel: Float = 0
     private(set) var fileURL: URL?
+    private var observers: [NSObjectProtocol] = []
+
+    /// Sichtbarer Zustand fuer die UI (Unterbrechung, Fortsetzung,
+    /// Mikrofonwechsel). Wird auf der Main-Queue gerufen.
+    var onStatus: ((String) -> Void)?
 
     func start() throws {
         #if os(iOS)
         let audioSession = AVAudioSession.sharedInstance()
-        try audioSession.setCategory(.record, mode: .measurement)
+        // .playAndRecord + UIBackgroundModes "audio" halten die Aufnahme
+        // auch bei gesperrtem Display am Leben (wie Apples Sprachmemos);
+        // .measurement laesst das iOS-Voice-Processing aus -- besser fuer
+        // Raum-Mikrofonie und die DGX-ASR.
+        try audioSession.setCategory(.playAndRecord, mode: .measurement, options: [.allowBluetooth, .defaultToSpeaker])
         try audioSession.setActive(true)
         #endif
+        installObservers()
+
+        let url = Self.recordingsDirectory().appendingPathComponent(Self.recordingName())
+        let file = try AVAudioFile(forWriting: url, settings: targetFormat.settings)
+        audioFile = file
+        fileURL = url
+
+        try attachTap()
+    }
 
+    /// Documents/Aufnahmen: sichtbar in der Dateien-App -- dieselbe
+    /// Rettungslogik wie beim On-Device-Pfad. tmp/ kann iOS jederzeit
+    /// leeren; eine Meeting-Aufnahme darf dort nicht liegen.
+    private static func recordingsDirectory() -> URL {
+        let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+        let directory = documents.appendingPathComponent("Aufnahmen", isDirectory: true)
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    private static func recordingName() -> String {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "yyyy-MM-dd-HHmmss"
+        return "voicehub-meeting-\(formatter.string(from: Date())).wav"
+    }
+
+    /// (Re-)installs the input tap. Das Eingabeformat kann sich mit der
+    /// Route aendern (AirPods getrennt -> eingebautes Mikrofon); dann
+    /// braucht es einen frischen Converter und Tap auf demselben File.
+    private func attachTap() throws {
         let input = engine.inputNode
+        input.removeTap(onBus: 0)
         let inputFormat = input.outputFormat(forBus: 0)
-        guard let converter = AVAudioConverter(from: inputFormat, to: targetFormat) else {
+        guard inputFormat.sampleRate > 0, let converter = AVAudioConverter(from: inputFormat, to: targetFormat) else {
             throw NSError(
                 domain: "MeetingAudioRecorder", code: 1,
                 userInfo: [NSLocalizedDescriptionKey: "Resampler konnte nicht erstellt werden"]
@@ -33,12 +80,6 @@ final class MeetingAudioRecorder {
         }
         self.converter = converter
 
-        let url = FileManager.default.temporaryDirectory
-            .appendingPathComponent("voicehub-meeting-\(UUID().uuidString).wav")
-        let file = try AVAudioFile(forWriting: url, settings: targetFormat.settings)
-        audioFile = file
-        fileURL = url
-
         input.installTap(onBus: 0, bufferSize: 4096, format: inputFormat) { [weak self] buffer, _ in
             self?.process(buffer: buffer)
         }
@@ -46,6 +87,82 @@ final class MeetingAudioRecorder {
         try engine.start()
     }
 
+    private func installObservers() {
+        #if os(iOS)
+        let center = NotificationCenter.default
+        observers.append(center.addObserver(
+            forName: AVAudioSession.interruptionNotification, object: nil, queue: .main
+        ) { [weak self] notification in
+            self?.handleInterruption(notification)
+        })
+        observers.append(center.addObserver(
+            forName: AVAudioSession.routeChangeNotification, object: nil, queue: .main
+        ) { [weak self] notification in
+            self?.handleRouteChange(notification)
+        })
+        observers.append(center.addObserver(
+            forName: AVAudioSession.mediaServicesWereResetNotification, object: nil, queue: .main
+        ) { [weak self] _ in
+            self?.restartAfterSystemReset()
+        })
+        #endif
+    }
+
+    #if os(iOS)
+    /// Anruf, Siri oder Wecker nehmen jeder App das Mikrofon. Die Datei
+    /// bleibt offen; nach dem Ende der Unterbrechung wird an derselben Datei
+    /// weitergeschrieben -- die Luecke ist hoerbar, aber nichts ist verloren.
+    private func handleInterruption(_ notification: Notification) {
+        guard audioFile != nil,
+              let raw = notification.userInfo?[AVAudioSessionInterruptionTypeKey] as? UInt,
+              let type = AVAudioSession.InterruptionType(rawValue: raw) else { return }
+        switch type {
+        case .began:
+            engine.pause()
+            onStatus?("Aufnahme unterbrochen (Anruf/Siri) – wird automatisch fortgesetzt.")
+        case .ended:
+            do {
+                try AVAudioSession.sharedInstance().setActive(true)
+                try attachTap()
+                onStatus?("Aufnahme läuft weiter.")
+            } catch {
+                onStatus?("Aufnahme konnte nicht fortgesetzt werden – bisheriges Audio ist gesichert.")
+            }
+        @unknown default:
+            break
+        }
+    }
+
+    private func handleRouteChange(_ notification: Notification) {
+        guard audioFile != nil,
+              let raw = notification.userInfo?[AVAudioSessionRouteChangeReasonKey] as? UInt,
+              let reason = AVAudioSession.RouteChangeReason(rawValue: raw),
+              reason == .oldDeviceUnavailable || reason == .newDeviceAvailable else { return }
+        do {
+            try attachTap()
+            if reason == .oldDeviceUnavailable {
+                onStatus?("Mikrofon gewechselt (z. B. AirPods getrennt) – Aufnahme läuft weiter.")
+            }
+        } catch {
+            onStatus?("Mikrofonwechsel fehlgeschlagen – bisheriges Audio ist gesichert.")
+        }
+    }
+
+    /// Kompletter Neuaufbau nach einem Media-Services-Reset des Systems --
+    /// die alte Engine ist danach unbrauchbar.
+    private func restartAfterSystemReset() {
+        guard audioFile != nil else { return }
+        engine = AVAudioEngine()
+        do {
+            try AVAudioSession.sharedInstance().setActive(true)
+            try attachTap()
+            onStatus?("Audiosystem neu gestartet – Aufnahme läuft weiter.")
+        } catch {
+            onStatus?("Audiosystem-Neustart fehlgeschlagen – bisheriges Audio ist gesichert.")
+        }
+    }
+    #endif
+
     private func process(buffer: AVAudioPCMBuffer) {
         updateLevel(from: buffer)
         guard let converter, let audioFile else { return }
@@ -70,9 +187,11 @@ final class MeetingAudioRecorder {
     }
 
     /// Stops capture and returns the recorded file's URL, or nil if nothing
-    /// was captured. The caller is responsible for deleting the file after
-    /// upload (see DictationViewModel.stopStudioMeetingRecording).
+    /// was captured. The caller deletes the file only after the upload
+    /// succeeded (see DictationViewModel.stopStudioMeetingRecording).
     func stop() -> URL? {
+        for observer in observers { NotificationCenter.default.removeObserver(observer) }
+        observers.removeAll()
         engine.inputNode.removeTap(onBus: 0)
         engine.stop()
         audioFile = nil // closing the AVAudioFile flushes and finalizes it
diff --git a/ios/project.yml b/ios/project.yml
index 50a3e24..658a63f 100644
--- a/ios/project.yml
+++ b/ios/project.yml
@@ -33,6 +33,12 @@ targets:
       path: VoiceHub/Info.plist
       properties:
         CFBundleDisplayName: VoiceHub
+        # Recording must survive the lock screen: the audio background mode
+        # keeps an active AVAudioSession capturing while the phone is locked
+        # or the app is in the background (same mechanism as Voice Memos).
+        # Without it iOS suspends the app on lock and the meeting dies.
+        UIBackgroundModes:
+          - audio
         # Recordings live in Documents and must be reachable from the Files
         # app, otherwise a rescued conversation is stuck inside the sandbox.
         UIFileSharingEnabled: true
