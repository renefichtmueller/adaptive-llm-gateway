From e52d20867aaeaf53a739ea163ba00977166cec7b Mon Sep 17 00:00:00 2001
From: Rene Fichtmueller <rf@flexoptix.net>
Date: Thu, 27 Aug 2026 06:01:22 +0000
Subject: [PATCH 04/11] chore(pwa): bump shell to v26 and cache the chunk vault

Versionierte URLs und Cache-Name folgen dem Muster vom 23.08., damit CDN
und offene Tabs die neuen Dateien sicher ausliefern; chunk-vault.js wird
Teil der Shell (Offline-Cache + Update-Pfad).
---
 tests/test_voiceprint_lifecycle.py         |  2 +-
 tests/test_web_meeting_capture_contract.py |  2 +-
 web/public/index.html                      |  2 +-
 web/public/js/app.js                       | 10 +++++-----
 web/public/sw.js                           |  3 ++-
 5 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/tests/test_voiceprint_lifecycle.py b/tests/test_voiceprint_lifecycle.py
index c1f40da..5432d10 100644
--- a/tests/test_voiceprint_lifecycle.py
+++ b/tests/test_voiceprint_lifecycle.py
@@ -479,4 +479,4 @@ def test_pwa_exposes_responsive_metadata_only_voiceprint_lifecycle() -> None:
     assert "Widerrufen – DGX-Löschung ausstehend" in app
     assert "Löschung verifiziert" in app
     assert "provider_reference" not in app
-    assert "voicehub-shell-v25" in service_worker
+    assert "voicehub-shell-v26" in service_worker
diff --git a/tests/test_web_meeting_capture_contract.py b/tests/test_web_meeting_capture_contract.py
index 3348ac1..d88829f 100644
--- a/tests/test_web_meeting_capture_contract.py
+++ b/tests/test_web_meeting_capture_contract.py
@@ -116,7 +116,7 @@ def test_confirmed_speaker_names_replace_only_line_prefixes() -> None:
 
 
 def test_service_worker_caches_meeting_recorder_with_new_shell_version() -> None:
-    assert "voicehub-shell-v25" in SERVICE_WORKER
+    assert "voicehub-shell-v26" in SERVICE_WORKER
     assert "'/js/meeting-recorder.js'" in SERVICE_WORKER
 
 
diff --git a/web/public/index.html b/web/public/index.html
index bb4821d..5bc8e0d 100644
--- a/web/public/index.html
+++ b/web/public/index.html
@@ -1579,7 +1579,7 @@
   </div>
 </div>
 
-<script type="module" src="js/app.js?v25"></script>
+<script type="module" src="js/app.js?v26"></script>
 
 </body>
 </html>
diff --git a/web/public/js/app.js b/web/public/js/app.js
index fd6d324..ebb575d 100644
--- a/web/public/js/app.js
+++ b/web/public/js/app.js
@@ -1,7 +1,7 @@
 import { AudioCapture } from './audio-capture.js';
 import { DictationSession } from './dictation-session.js';
-import { MeetingRecorder, uploadAndDiarize } from './meeting-recorder.js?v25';
-import { chunkVault } from './chunk-vault.js?v25';
+import { MeetingRecorder, uploadAndDiarize } from './meeting-recorder.js?v26';
+import { chunkVault } from './chunk-vault.js?v26';
 
 const body = document.body;
 const transcriptEl = document.getElementById('transcript');
@@ -164,7 +164,7 @@ let isAuthenticated = false;
 let sessionProjectIds = [];
 // Kept in sync with CACHE_NAME in sw.js -- lets a user tell at a glance
 // whether the browser is running the deployed version or a stale tab.
-const UI_VERSION = 'v25';
+const UI_VERSION = 'v26';
 let voiceprintLifecycleLoadKey = null;
 
 const IS_IOS = /iP(hone|ad|od)/.test(navigator.userAgent)
@@ -2711,7 +2711,7 @@ async function checkForUpdate() {
     const registrations = await navigator.serviceWorker?.getRegistrations?.() || [];
     await Promise.all(registrations.map((registration) => registration.update()));
     await Promise.all(
-      ['/', '/js/app.js', '/js/meeting-recorder.js', '/sw.js'].map((path) =>
+      ['/', '/js/app.js', '/js/meeting-recorder.js', '/js/chunk-vault.js', '/sw.js'].map((path) =>
         fetch(path, { cache: 'reload' }).catch(() => null),
       ),
     );
@@ -3077,5 +3077,5 @@ window.addEventListener('online', pollHealth);
 window.addEventListener('offline', () => renderConnectivity(false));
 
 if ('serviceWorker' in navigator) {
-  window.addEventListener('load', () => navigator.serviceWorker.register('sw.js?v25').catch(() => {}));
+  window.addEventListener('load', () => navigator.serviceWorker.register('sw.js?v26').catch(() => {}));
 }
diff --git a/web/public/sw.js b/web/public/sw.js
index 935675f..a481e73 100644
--- a/web/public/sw.js
+++ b/web/public/sw.js
@@ -1,4 +1,4 @@
-const CACHE_NAME = 'voicehub-shell-v25';
+const CACHE_NAME = 'voicehub-shell-v26';
 const SHELL_FILES = [
   '/',
   '/manifest.json',
@@ -16,6 +16,7 @@ const SHELL_FILES = [
   '/fonts/Inter-BoldItalic.woff2',
   '/js/app.js',
   '/js/audio-capture.js',
+  '/js/chunk-vault.js',
   '/js/dictation-session.js',
   '/js/meeting-recorder.js',
   '/js/recorder-worklet.js',
