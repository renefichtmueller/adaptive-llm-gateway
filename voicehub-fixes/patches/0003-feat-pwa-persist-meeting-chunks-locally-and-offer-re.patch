diff --git a/web/public/js/chunk-vault.js b/web/public/js/chunk-vault.js
new file mode 100644
index 0000000..63545a0
--- /dev/null
+++ b/web/public/js/chunk-vault.js
@@ -0,0 +1,141 @@
+/**
+ * Lokale Absicherung der Meeting-Aufnahme (IndexedDB): Jeder MediaRecorder-
+ * Chunk wird sofort nach dem Eintreffen persistiert. Stirbt der Tab --
+ * iOS-Sperre, Absturz, Speicherdruck, versehentliches Schliessen -- bleibt
+ * das Audio erhalten und wird beim naechsten Start zur Verarbeitung
+ * angeboten. Kein Ersatz fuer den Server: nur die Versicherung, dass der
+ * Weg dorthin nie das einzige Exemplar transportiert.
+ */
+const DB_NAME = 'voicehub-capture-vault';
+const DB_VERSION = 1;
+const CAPTURES = 'captures';
+const CHUNKS = 'chunks';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, DB_VERSION);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(CAPTURES)) {
+        db.createObjectStore(CAPTURES, { keyPath: 'captureId' });
+      }
+      if (!db.objectStoreNames.contains(CHUNKS)) {
+        const store = db.createObjectStore(CHUNKS, { keyPath: ['captureId', 'sequence'] });
+        store.createIndex('byCapture', 'captureId');
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error || new Error('IndexedDB nicht verfügbar'));
+  });
+}
+
+// Resolved erst mit oncomplete der Transaktion, damit Schreibzugriffe
+// wirklich persistiert sind, bevor der Aufrufer weitermacht.
+async function withTransaction(storeNames, mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(storeNames, mode);
+      let result;
+      try {
+        result = fn(tx);
+      } catch (err) {
+        reject(err);
+        return;
+      }
+      tx.oncomplete = () => resolve(result);
+      tx.onabort = () => reject(tx.error || new Error('IndexedDB-Transaktion abgebrochen'));
+      tx.onerror = () => reject(tx.error || new Error('IndexedDB-Transaktion fehlgeschlagen'));
+    });
+  } finally {
+    db.close();
+  }
+}
+
+function requestValue(request) {
+  return new Promise((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+export const chunkVault = {
+  /** Meldet eine neue Capture an. Die Metadaten reichen fuer die spaetere
+   *  Wiederherstellung: Upload braucht meetingId, Dateiendung und die
+   *  erwartete Sprecheranzahl. */
+  async begin({ captureId, meetingId, mimeType, fileExtension, expectedSpeakers, meetingTitle }) {
+    await withTransaction([CAPTURES], 'readwrite', (tx) => {
+      tx.objectStore(CAPTURES).put({
+        captureId,
+        meetingId,
+        mimeType: mimeType || '',
+        fileExtension: fileExtension || 'webm',
+        expectedSpeakers: expectedSpeakers || null,
+        meetingTitle: meetingTitle || '',
+        startedAt: new Date().toISOString(),
+      });
+    });
+  },
+
+  async append(captureId, sequence, blob) {
+    await withTransaction([CHUNKS], 'readwrite', (tx) => {
+      tx.objectStore(CHUNKS).put({ captureId, sequence, blob });
+    });
+  },
+
+  /** Alle Captures, fuer die noch Audio im Tresor liegt; Eintraege ohne
+   *  Chunks werden dabei gleich aufgeraeumt. */
+  async listOpen() {
+    const db = await openDb();
+    let captures = [];
+    try {
+      captures = (await requestValue(db.transaction(CAPTURES).objectStore(CAPTURES).getAll())) || [];
+      const withAudio = [];
+      for (const capture of captures) {
+        const keys = await requestValue(
+          db.transaction(CHUNKS).objectStore(CHUNKS).index('byCapture').getAllKeys(capture.captureId),
+        );
+        if (keys && keys.length > 0) {
+          withAudio.push({ ...capture, chunkCount: keys.length });
+        }
+      }
+      return withAudio;
+    } finally {
+      db.close();
+    }
+  },
+
+  /** Setzt die Chunks einer Capture in Sequenz-Reihenfolge zu einem Blob
+   *  zusammen -- exakt so, wie es der normale Stopp-Pfad auch tut. */
+  async assemble(captureId) {
+    const db = await openDb();
+    try {
+      const meta = await requestValue(db.transaction(CAPTURES).objectStore(CAPTURES).get(captureId));
+      const rows = (await requestValue(
+        db.transaction(CHUNKS).objectStore(CHUNKS).index('byCapture').getAll(captureId),
+      )) || [];
+      if (!meta || rows.length === 0) return null;
+      rows.sort((a, b) => a.sequence - b.sequence);
+      return {
+        meta,
+        blob: new Blob(rows.map((row) => row.blob), { type: meta.mimeType || rows[0].blob.type }),
+      };
+    } finally {
+      db.close();
+    }
+  },
+
+  async discard(captureId) {
+    await withTransaction([CAPTURES, CHUNKS], 'readwrite', (tx) => {
+      tx.objectStore(CAPTURES).delete(captureId);
+      const chunkStore = tx.objectStore(CHUNKS);
+      const cursorRequest = chunkStore.index('byCapture').openKeyCursor(IDBKeyRange.only(captureId));
+      cursorRequest.onsuccess = () => {
+        const cursor = cursorRequest.result;
+        if (!cursor) return;
+        chunkStore.delete(cursor.primaryKey);
+        cursor.continue();
+      };
+    });
+  },
+};
