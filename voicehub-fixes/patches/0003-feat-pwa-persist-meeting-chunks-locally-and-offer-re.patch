+/// Wiederherstellung unterbrochener Aufnahmen: Liegt im IndexedDB-Tresor
+/// noch Audio einer Capture, die nie fertig hochgeladen wurde (Sperre,
+/// Absturz, geschlossener Tab), wird sie hier zur Verarbeitung angeboten
+/// statt still verloren zu gehen.
+let recoveryCapture = null;
+
+async function offerCaptureRecovery() {
+  // Ein stale ausgeliefertes index.html (CDN-Falle vom 23.08.) kennt das
+  // Banner noch nicht -- dann lieber still bleiben als hier zu werfen.
+  if (!recoveryBanner || !recoveryBannerDetail || !recoveryUploadBtn || !recoveryDiscardBtn) return;
+  let open = [];
+  try {
+    open = await chunkVault.listOpen();
+  } catch {
+    return; // Kein IndexedDB (privater Modus o.ae.) -- dann gibt es auch keinen Tresor.
+  }
+  const candidates = open.filter((capture) => capture.captureId !== currentMeeting?.capture_id);
+  if (!candidates.length) {
+    setVisible(recoveryBanner, false);
+    return;
+  }
+  candidates.sort((a, b) => (b.startedAt || '').localeCompare(a.startedAt || ''));
+  recoveryCapture = candidates[0];
+  const startedAt = recoveryCapture.startedAt
+    ? new Date(recoveryCapture.startedAt).toLocaleString('de-DE')
+    : 'unbekanntem Zeitpunkt';
+  const minutes = Math.max(1, Math.round((recoveryCapture.chunkCount * 2) / 60));
+  recoveryBannerDetail.textContent =
+    `${recoveryCapture.meetingTitle ? `„${recoveryCapture.meetingTitle}“ ` : ''}vom ${startedAt} · ca. ${minutes} min Audio warten auf Verarbeitung.`;
+  setVisible(recoveryBanner, true);
+}
+
+async function recoverInterruptedCapture() {
+  if (!recoveryCapture || !requireServerAvailable()) return;
+  recoveryUploadBtn.disabled = true;
+  recoveryDiscardBtn.disabled = true;
+  try {
+    const assembled = await chunkVault.assemble(recoveryCapture.captureId);
+    if (!assembled || !assembled.blob.size) {
+      await chunkVault.discard(recoveryCapture.captureId);
+      recoveryCapture = null;
+      setVisible(recoveryBanner, false);
+      return;
+    }
+    const { meta, blob } = assembled;
+    // Meeting-Uploads verlangen eine gestoppte Capture -- den Serverstand
+    // vorher abgleichen. Ein verschwundenes Meeting blockiert nicht: dann
+    // wird ohne meeting_id transkribiert, damit das Audio nie haengt.
+    let meetingId = meta.meetingId || null;
+    if (meetingId) {
+      try {
+        let meeting = await apiJson(`/meetings/${meetingId}`);
+        if (meeting.capture_state === 'recording' || meeting.capture_state === 'paused') {
+          meeting = await apiJson(`/meetings/${meetingId}/capture/stop`, { method: 'POST' });
+        }
+        currentMeetingId = meetingId;
+        currentMeeting = meeting;
+      } catch {
+        meetingId = null;
+      }
+    }
+    setVisible(recoveryBanner, false);
+    setState('finishing');
+    showHint('Wiederhergestellte Aufnahme wird transkribiert und nach Sprechern getrennt…', false);
+    const job = await uploadAndDiarize(blob, meta.fileExtension || 'webm', meta.expectedSpeakers || undefined, meetingId);
+    await chunkVault.discard(recoveryCapture.captureId);
+    recoveryCapture = null;
+    anonymousMeetingText = job.text || '';
+    finalText = anonymousMeetingText;
+    renderTranscript(finalText ? [{ text: finalText }] : [], '');
+    renderSpeakerReview(job.speaker_labels || []);
+    if (meetingId) renderMeetingReview();
+    setState('reviewing');
+    showToast('Wiederhergestellte Aufnahme verarbeitet.');
+    showView('transcript');
+  } catch (err) {
+    recoveryUploadBtn.disabled = false;
+    recoveryDiscardBtn.disabled = false;
+    setVisible(recoveryBanner, true);
+    showHint('Wiederherstellung fehlgeschlagen; das Audio bleibt lokal erhalten. ' + (err?.message || ''), true);
+    setState('idle');
+  }
+}
+
+recoveryUploadBtn?.addEventListener('click', () => { void recoverInterruptedCapture(); });
+recoveryDiscardBtn?.addEventListener('click', () => {
+  if (!recoveryCapture) return;
+  if (!window.confirm('Unterbrochene Aufnahme endgültig verwerfen? Das Audio ist danach weg.')) return;
+  chunkVault.discard(recoveryCapture.captureId)
+    .then(() => {
+      recoveryCapture = null;
+      setVisible(recoveryBanner, false);
+      showToast('Aufnahme verworfen.');
+    })
+    .catch(() => showToast('Verwerfen fehlgeschlagen.'));
+});
+
+void offerCaptureRecovery();
