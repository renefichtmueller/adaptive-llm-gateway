# ─── Adaptive LLM Gateway — Environment Variables ──────────────────────────
# Copy this file to `.env` and fill in the values you need. Everything left
# blank stays disabled; the gateway auto-detects what works.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3103
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/llm_gateway
LOG_LEVEL=info

# ─── Local LLM servers ────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=
LLAMAFILE_URL=
VLLM_URL=

# ─── Discovery + auto-spawn ───────────────────────────────────────────────
# When set to "1", the gateway scans for installed CLI subscriptions on boot
# and spawns inline HTTP bridges on free ports.
AUTO_SPAWN_BRIDGES=0

# ─── Subscription bridges ─────────────────────────────────────────────────
# Each *_BRIDGE_URL points at a running bridge HTTP wrapper for a paid CLI
# subscription. Auto-discovery fills these in if it finds the CLI installed.
CLAUDE_BRIDGE_URL=
OPENAI_BRIDGE_URL=
CHATGPT_BRIDGE_URL=
COPILOT_BRIDGE_URL=
M365_COPILOT_BRIDGE_URL=
CODEX_BRIDGE_URL=
GEMINI_BRIDGE_URL=
AIDER_BRIDGE_URL=

# ─── API-key providers (free tier or paid) ────────────────────────────────
# Set any you want available as fallback. Leave blank to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_AI_TOKEN=

# ─── Compression ──────────────────────────────────────────────────────────
LLM_GATEWAY_COMPRESSION_ENABLED=true
LLM_GATEWAY_MIN_TOKENS=700
LLM_GATEWAY_TARGET_TOKENS=2400

# ─── Dashboard auth ───────────────────────────────────────────────────────
# Required for any /api/dashboard/* endpoint. Use a random 32+ char string.
DASHBOARD_AUTH_TOKEN=

# ─── Optional integrations ────────────────────────────────────────────────
# Uncomment + configure only the ones you actually use.
# GITHUB_TOKEN=
# OPENAI_ORG_ID=
