# ─── Adaptive LLM Gateway — Environment Variables ──────────────────────────
# Copy this file to `.env` and fill in the values you need. Everything left
# blank stays disabled; the gateway auto-detects what works.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/llm_gateway
LOG_LEVEL=info

# ─── Local LLM servers (auto-probed) ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=
LLAMAFILE_URL=
VLLM_URL=

# ─── Autonomy / learning loop ─────────────────────────────────────────────
# Shared secret between gateway and learning engine (X-Internal-Secret).
# CHANGE THIS outside single-host development setups.
INTERNAL_SECRET=internal-learning-secret
# Adaptive routing is ON by default (learner recommends the best model per
# task type from real traffic). Set "0" to disable.
ADAPTIVE_ROUTING_ENABLED=1
# Tuning knobs (defaults shown): samples needed before a recommendation,
# confidence counted as success, refresh interval, lookback window.
#ADAPTIVE_MIN_SAMPLES=100
#ADAPTIVE_MIN_CONFIDENCE=7.0
#ADAPTIVE_REFRESH_MS=900000
#ADAPTIVE_LOOKBACK_DAYS=7
# Promoted ban-learner terms become active ban terms (default on).
#LEARNED_BANLIST_ENABLED=1
# Fine-tuning: examples per task type before a run is triggered, and where
# the JSONL training sets are exported.
#FINE_TUNING_MIN_EXAMPLES=500
#FINE_TUNING_EXPORT_DIR=./fine-tuning-exports

# ─── Discovery + auto-spawn ───────────────────────────────────────────────
# Set "1" to auto-spawn detected CLI bridges at boot.
AUTO_SPAWN_BRIDGES=0

# ─── Subscription bridges (auto-detected via subscription-discovery) ─────
CLAUDE_BRIDGE_URL=
OPENAI_BRIDGE_URL=
CHATGPT_BRIDGE_URL=
COPILOT_BRIDGE_URL=
M365_COPILOT_BRIDGE_URL=
CODEX_BRIDGE_URL=
GEMINI_BRIDGE_URL=
AIDER_BRIDGE_URL=

# ─── Free-tier providers ─────────────────────────────────────────────────
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_AI_TOKEN=

# ─── Hosted inference platforms ──────────────────────────────────────────
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
ANYSCALE_API_KEY=
REPLICATE_API_TOKEN=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# ─── Frontier API providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Search / auxiliary ─────────────────────────────────────────────────
BRAVE_API_KEY=

# ─── Compression ──────────────────────────────────────────────────────────
LLM_GATEWAY_COMPRESSION_ENABLED=true
LLM_GATEWAY_MIN_TOKENS=700
LLM_GATEWAY_TARGET_TOKENS=2400

# ─── Dashboard auth ───────────────────────────────────────────────────────
# Required for any /api/dashboard/* endpoint. Use a random 32+ char string.
DASHBOARD_AUTH_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for browser-side calls. Localhost is
# always allowed; add any other host you serve dashboards from.
GATEWAY_CORS_ORIGINS=
