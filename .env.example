# ─── Adaptive LLM Gateway — Environment Variables ──────────────────────────
# Copy this file to `.env` and fill in the values you need. Everything left
# blank stays disabled; the gateway auto-detects what works.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=0000
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/llm_gateway
LOG_LEVEL=info

# ─── Local LLM servers (auto-probed) ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=
LLAMAFILE_URL=
VLLM_URL=

# ─── Discovery + auto-spawn ───────────────────────────────────────────────
# Set "1" to auto-spawn detected CLI bridges at boot.
AUTO_SPAWN_BRIDGES=0

# ─── Subscription bridges (auto-detected via subscription-discovery) ─────
CLAUDE_BRIDGE_URL=
OPENAI_BRIDGE_URL=
CHATGPT_BRIDGE_URL=
COPILOT_BRIDGE_URL=
M365_COPILOT_BRIDGE_URL=
CODEX_BRIDGE_URL=
GEMINI_BRIDGE_URL=
AIDER_BRIDGE_URL=

# ─── Free-tier providers ─────────────────────────────────────────────────
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_AI_TOKEN=

# ─── Hosted inference platforms ──────────────────────────────────────────
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
ANYSCALE_API_KEY=
REPLICATE_API_TOKEN=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# ─── Frontier API providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Search / auxiliary ─────────────────────────────────────────────────
BRAVE_API_KEY=

# ─── Compression ──────────────────────────────────────────────────────────
LLM_GATEWAY_COMPRESSION_ENABLED=true
LLM_GATEWAY_MIN_TOKENS=700
LLM_GATEWAY_TARGET_TOKENS=2400

# ─── Scorer fast-path ─────────────────────────────────────────────────────
# Skip the LLM pre-classifier round-trip for clearly-simple requests: the
# keyword request-scorer classifies them into the `fast` tier in sub-ms with no
# inference. Opt-in; off by default (behaviour unchanged). See scorer-fastpath.ts.
SCORER_FASTPATH_ENABLED=0
# Minimum scorer confidence (0..1) required to skip the LLM classifier.
SCORER_FASTPATH_MIN_CONFIDENCE=0.7
# Comma-separated tiers allowed to short-circuit. Widen (e.g. "fast,medium")
# to trade a little routing precision for lower latency on more requests.
SCORER_FASTPATH_TIERS=fast
# task_type used when the fast-path fires.
SCORER_FASTPATH_TASK_TYPE=generic_qa

# ─── Dashboard auth ───────────────────────────────────────────────────────
# Required for any /api/dashboard/* endpoint. Use a random 32+ char string.
DASHBOARD_AUTH_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for browser-side calls. Localhost is
# always allowed; add any other host you serve dashboards from.
GATEWAY_CORS_ORIGINS=
