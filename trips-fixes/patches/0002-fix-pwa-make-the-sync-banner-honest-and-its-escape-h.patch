+      setSyncing(true);
+      if (watchdog.current) clearTimeout(watchdog.current);
+      watchdog.current = setTimeout(() => setSyncing(false), SYNC_WATCHDOG_MS);
+      const delivered = await postToWorker(message);
+      if (!delivered) endSync();
+      return delivered;
+    },
+    [postToWorker, endSync]
